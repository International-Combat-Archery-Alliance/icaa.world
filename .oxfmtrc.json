{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": true,
  "trailingComma": "all",
  "singleQuote": true,
  "printWidth": 80,
  "tabWidth": 2,
  "sortPackageJson": false,
  "sortTailwindcss": true,
  "ignorePatterns": [
    "node_modules",
    "dist",
    ".wrangler",
    ".github",
    "src/api/*.d.ts"
  ]
}
