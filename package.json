{
  "type": "module",
  "scripts": {
    "dev": "bunx --bun vite",
    "full-dev": "concurrently \"bun dev\" \"bun run-all-backend\"",
    "build": "vite build",
    "preview": "vite preview",
    "test:ts": "tsc --noEmit",
    "codegen": "openapi-typescript https://api.icaa.world/events/openapi.json -o ./src/api/events-v1.d.ts; openapi-typescript https://api.icaa.world/login/openapi.json -o ./src/api/login.d.ts; openapi-typescript https://api.icaa.world/assets/openapi.json -o ./src/api/assets-api-v1.d.ts; openapi-typescript https://api.icaa.world/donations/openapi.json -o ./src/api/donations-v1.d.ts; openapi-typescript https://api.icaa.world/articles/openapi.json -o ./src/api/articles-v1.d.ts; openapi-typescript https://api.icaa.world/mailing-list/openapi.json -o ./src/api/mailing-list-v1.d.ts; openapi-typescript https://api.icaa.world/voting/openapi.json -o ./src/api/voting-v1.d.ts",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix --deny-warnings",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "prepare": "husky",
    "run-shared-infra": "docker compose up -d",
    "run-login-service": "cd ../login && make local",
    "run-event-service": "cd ../event-registration && make local",
    "run-assets-service": "cd ../assets-api && make local",
    "run-articles-service": "cd ../articles-api && make local",
    "run-donation-service": "cd ../donation-api && make local",
    "run-mailing-list-service": "cd ../mailing-list-api && make local",
    "run-voting-service": "cd ../voting-api && make local",
    "run-all-backend": "bun run-shared-infra && concurrently \"bun run-login-service\" \"bun run-event-service\" \"bun run-assets-service\" \"bun run-articles-service\" \"bun run-donation-service\" \"bun run-mailing-list-service\" \"bun run-voting-service\""
  },
  "devDependencies": {
    "@types/luxon": "^3.7.4",
    "concurrently": "^10.0.4",
    "husky": "^9.1.7",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-plugin-query": "^0.1.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.120.1"
  },
  "dependencies": {
    "@editorjs/delimiter": "^1.4.2",
    "@editorjs/editorjs": "^2.31.6",
    "@editorjs/embed": "^2.8.0",
    "@editorjs/header": "^2.8.9",
    "@editorjs/image": "^2.10.3",
    "@editorjs/link": "^2.6.2",
    "@editorjs/list": "^2.0.9",
    "@editorjs/paragraph": "^2.11.7",
    "@editorjs/quote": "^2.7.6",
    "@editorjs/table": "^2.4.5",
    "@editorjs/underline": "^1.2.1",
    "@hookform/resolvers": "^5.7.1",
    "@newrelic/browser-agent": "^1.320.0",
    "@opentelemetry/auto-instrumentations-web": "^0.45.0",
    "@opentelemetry/core": "^1.30.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.0",
    "@opentelemetry/resources": "^1.30.0",
    "@opentelemetry/sdk-trace-base": "^1.30.0",
    "@opentelemetry/sdk-trace-web": "^1.30.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@react-oauth/google": "^0.13.5",
    "@stripe/react-stripe-js": "^6.8.1",
    "@stripe/stripe-js": "^8.11.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.564.0",
    "luxon": "^3.7.2",
    "maplibre-gl": "^6.3.0",
    "next-themes": "^0.4.6",
    "openapi-fetch": "^0.17.0",
    "openapi-react-query": "^0.5.4",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-day-picker": "^9.13.2",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-icons": "^5.7.0",
    "react-map-gl": "^8.1.2",
    "react-router-dom": "^7.18.2",
    "react-turnstile": "^1.1.5",
    "react-use": "^17.6.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "ts-money": "^0.4.8",
    "vite": "^8.2.1",
    "zod": "^4.4.3"
  }
}
